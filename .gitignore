# Node
node_modules/
dist/
dist-ssr/
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Demo docs (user requested to exclude)
demo_pdf_docs/

# Logs
logs/
*.log
npm-debug.log*

# Editor
.vscode/
.DS_Store

# DB
creditiq.db

# Runtime-generated artifacts (regenerated by the analysis pipeline).
# backend/data/ is deliberately NOT ignored — the routers read those JSON
# payloads to serve results for existing analyses.
#
# Exception: financials_*.json holds financial statement lines extracted from
# the borrower's uploaded documents. That is real borrower data and must never
# be committed. It is regenerated by the OCR step on each analysis.
backend/data/financials_*.json
backend/uploads/*
!backend/uploads/.gitkeep
backend/graphs/*
!backend/graphs/.gitkeep
backend/docs/*
!backend/docs/.gitkeep

