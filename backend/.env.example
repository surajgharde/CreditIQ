# CreditIQ backend configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
DATABASE_URL=                 # omit to use the local SQLite file
JWT_SECRET=                   # required: any long random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CAM generation (required for memo output) ---
COHERE_API_KEY=

# --- Multilingual chat assistant (EN/HI/MR) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# --- Telegram bot ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Operator chat IDs (comma separated) that may see EVERY company.
# Per-company access is granted in the app's Profile page instead, which
# links one chat to one company. Leave this empty unless you want an
# unscoped operator chat.
TELEGRAM_ALLOWED_CHAT_IDS=
# Required when using the webhook endpoint rather than telegram_bot.py.
# TELEGRAM_WEBHOOK_SECRET=

# --- CAM length / throughput tuning (all optional) ---
# CAM_SECTION_WORDS=175    # ~13 pages; ~30 words per section = 1 page
# CAM_CONCURRENCY=3        # parallel section requests (1-6)
# CAM_RATE_LIMIT_PER_MIN=15  # Cohere Trial keys allow 20/min; one CAM needs 17
#                            # calls, so raise this only on a Production key.
# CAM_MODEL=command-r-08-2024

# --- Model training (required on a fresh clone only if the
#     pre-trained models in models/xgboost/ are absent) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Scanned-PDF OCR via AWS Textract ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- News / adverse-media retrieval ---
NEWS_API_KEY=

# --- Optional external data sources ---
GSTN_API_URL=
GSTN_API_TOKEN=
MCA_API_URL=
MCA_API_KEY=

# --- Optional notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
RM_EMAIL=
RM_PHONE_NUMBER=

# --- Optional infrastructure ---
REDIS_URL=
CHROMA_DB_PATH=
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=
