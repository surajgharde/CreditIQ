# CreditIQ backend configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
DATABASE_URL=                 # omit to use the local SQLite file
JWT_SECRET=                   # required: any long random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CAM generation (required for memo output) ---
COHERE_API_KEY=

# --- Multilingual chat assistant (EN/HI/MR) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Model training (required on a fresh clone only if the
#     pre-trained models in models/xgboost/ are absent) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Scanned-PDF OCR via AWS Textract ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- News / adverse-media retrieval ---
NEWS_API_KEY=

# --- Optional external data sources ---
GSTN_API_URL=
GSTN_API_TOKEN=
MCA_API_URL=
MCA_API_KEY=

# --- Optional notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
RM_EMAIL=
RM_PHONE_NUMBER=

# --- Optional infrastructure ---
REDIS_URL=
CHROMA_DB_PATH=
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=
